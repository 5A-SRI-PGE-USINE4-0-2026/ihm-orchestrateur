{
  "name": "mfja-salle315-ihm",
  "version": "1.0.0",
  "private": true,
  "description": "IHM de supervision bidirectionnelle et orchestrateur ROS 2 L1 — Salle 315 MFJA (UPSSITECH SRI)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node -e \"const {spawnSync}=require('child_process');const py=process.platform==='win32'?'python':'python3';process.exit(spawnSync(py,['-m','pytest','ros2_ws/src/mfja_orchestrator/test'],{stdio:'inherit'}).status??1)\"",
    "orchestrator": "node -e \"const {spawnSync}=require('child_process');const py=process.platform==='win32'?'python':'python3';process.exit(spawnSync(py,['scripts/run_orchestrator.py',...process.argv.slice(1)],{stdio:'inherit'}).status??1)\"",
    "orchestrator:j2": "node -e \"const {spawnSync}=require('child_process');const py=process.platform==='win32'?'python':'python3';process.exit(spawnSync(py,['scripts/run_orchestrator.py','--auto-start','j2','--loop'],{stdio:'inherit'}).status??1)\"",
    "orchestrator:j1": "node -e \"const {spawnSync}=require('child_process');const py=process.platform==='win32'?'python':'python3';process.exit(spawnSync(py,['scripts/run_orchestrator.py','--auto-start','j1','--loop'],{stdio:'inherit'}).status??1)\""
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
